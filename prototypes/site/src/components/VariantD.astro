---
// PROTOTYPE — Variante D, « Studio + repérage ». The composite Patrick asked for after
// seeing A, B and C:
//   - B's layout: medium player top left, metadata and cast under it, transcript right.
//   - A's turn grouping: consecutive Segments of one Speaker fused, so the column reads
//     instead of being shredded into ~7-second rows.
//   - C's coloured ribbon, now carrying the speaker's name.
// Names inside the bands do not work at this scale: grouping 1 595 Segments into 412 turns
// helps, but only the single longest turn of the debate is wide enough to fit a name. So
// the ribbon is split into one lane per Speaker with the name in a fixed left gutter — the
// name is then always readable, and the turn-taking pattern of the debate becomes visible
// as a side effect.
import Player from "./Player.astro";
import { clock, shakyWords } from "../lib/data.js";

const { data } = Astro.props;
const { meta, segments, words, participants, participantsById, embedded, reviewed } = data;

const turns = [];
for (const s of segments) {
  const last = turns.at(-1);
  if (last && last.speaker === s.speaker) last.segments.push(s);
  else turns.push({ speaker: s.speaker, segments: [s] });
}

const duration = meta.timeline.duration_s;
const cast = [...participants].filter((p) => p.segmentCount).sort((a, b) => b.speakingSeconds - a.speakingSeconds);

// One lane per Speaker, their turns drawn along it.
const lanes = cast.map((p) => ({
  speaker: p.speaker,
  name: p.name,
  colour: p.colour,
  minutes: Math.round(p.speakingSeconds / 60),
  bands: turns
    .filter((t) => t.speaker === p.speaker)
    .map((t) => {
      const start = t.segments[0].start;
      const end = t.segments.at(-1).end;
      return {
        id: t.segments[0].id,
        start,
        left: (start / duration) * 100,
        width: Math.max(0.12, ((end - start) / duration) * 100),
      };
    }),
}));
---

<div class="shell wide">
  <div class="ribbon-wrap">
    <p class="ribbon-title">
      Qui parle, du début à la fin. Cliquez n'importe où pour vous y rendre.
      <span class="readout" id="readout" />
    </p>
    <div class="lanes" data-duration={duration}>
      {
        lanes.map((lane) => (
          <div class="lane" data-speaker={lane.speaker}>
            <span class="lane-name" title={`${lane.name} — ${lane.minutes} min`}>{lane.name}</span>
            <span class="lane-track">
              {lane.bands.map((b) => (
                <button
                  class="band"
                  data-t={b.start}
                  data-name={lane.name}
                  title={`${lane.name} — ${clock(b.start)}`}
                  style={`left:${b.left}%;width:${b.width}%;background:${lane.colour}`}
                />
              ))}
            </span>
          </div>
        ))
      }
      <span class="cursor" hidden />
    </div>
    <div class="ticks">
      {[0, 0.25, 0.5, 0.75, 1].map((f) => <span>{clock(duration * f)}</span>)}
    </div>
  </div>

  <div class="layout">
    <aside>
      <Player replay={embedded} timeline={meta.timeline} />

      <h1>{meta.title}</h1>
      <p class="meta">
        {meta.programme} — {new Date(meta.date).toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })}
        <br />Source&nbsp;: {data.source?.name} · organisé par MEDEF · {meta.venue}
      </p>

      <p class="review">
        <span class="mark draft">{reviewed.total - reviewed.text} extraits non relus</span>
        <span class="mark verified">{reviewed.text} relus</span>
      </p>

      <h2>À l'antenne</h2>
      <ul class="cast">
        {
          cast.map((p) => (
            <li>
              <span class="chip" style={`background:${p.colour}`} />
              {p.candidate ? <a href={`/candidats/${p.speaker}`}>{p.name}</a> : <span>{p.name}</span>}
              <em>{Math.round(p.speakingSeconds / 60)} min</em>
            </li>
          ))
        }
      </ul>

      <p class="legal">
        L'enregistrement n'est pas hébergé ici&nbsp;: le lecteur ci-dessus est la copie
        officielle publiée par {embedded?.uploader}.
        <a href={meta.timeline.url} rel="noopener" target="_blank">Voir chez {meta.timeline.uploader}</a>
      </p>
    </aside>

    <main>
      <div class="toolbar">
        <label><input type="checkbox" id="follow" checked /> suivre la lecture</label>
        <label><input type="checkbox" id="only-draft" /> n'afficher que les prises de parole à relire</label>
      </div>

      {
        turns.map((turn) => {
          const p = participantsById[turn.speaker];
          const first = turn.segments[0];
          const last = turn.segments.at(-1);
          const textVerified = turn.segments.every((s) => s.textStatus === "verified");
          const speakerVerified = turn.segments.every((s) => s.speakerStatus === "verified");
          const overlap = turn.segments.some((s) => s.overlap);
          return (
            <section
              class="turn"
              id={first.id}
              data-t={first.start}
              data-end={last.end}
              data-speaker={turn.speaker}
              data-draft={!textVerified || !speakerVerified}
            >
              <p class="who">
                <button class="t" data-t={first.start}>{clock(first.start)}</button>
                <b style={`color:${p.colour}`}>{p.name}</b>
                {p.candidate && <span class="role">candidat·e</span>}
                {p.role === "journalist" && <span class="role">journaliste</span>}
                {p.role === "questioner" && <span class="role">question de la salle</span>}
                {overlap && <span class="over">voix simultanées</span>}
                {!speakerVerified && <span class="mark draft">locuteur à vérifier</span>}
                {textVerified && <span class="mark verified">texte vérifié</span>}
                <a class="anchor" href={`#${first.id}`} title="Lien permanent">#{first.id}</a>
              </p>
              <p class={textVerified ? "said" : "said is-draft"}>
                {turn.segments.map((s) => {
                  const shaky = s.textStatus === "draft" ? shakyWords(words, s.id) : new Set();
                  return (
                    <span class="seg" id={s.id} data-t={s.start} title={`${s.id} · ${clock(s.start)}`}>
                      {s.text.split(" ").map((w) => (shaky.has(w) ? <span class="shaky">{w}</span> : w)).reduce((a, b) => [a, " ", b])}
                      {" "}
                    </span>
                  );
                })}
              </p>
              <a class="fix" href="#">Corriger cette prise de parole</a>
            </section>
          );
        })
      }
    </main>
  </div>
</div>

<style>
  .shell { padding-block: 1.2rem 6rem; }

  /* --- C's ribbon, split into one named lane per Speaker -------------------- */
  .ribbon-wrap { margin-bottom: 1.5rem; }
  .ribbon-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0 0 0.4rem;
  }
  .readout { font-weight: 600; color: var(--ink); }
  .lanes {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.35rem 0.5rem;
    overflow: hidden;
  }
  .lane { display: flex; align-items: center; gap: 0.5rem; height: 13px; }
  .lane + .lane { margin-top: 1px; }
  .lane.dim { opacity: 0.35; }
  .lane-name {
    flex: none;
    width: 9.5rem;
    text-align: right;
    font: 500 0.7rem/1 -apple-system, "Segoe UI", Roboto, sans-serif;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lane.on .lane-name { color: var(--ink); font-weight: 700; }
  .lane-track { position: relative; flex: 1; height: 100%; background: #f1f3f5; border-radius: 2px; }
  .band {
    all: unset;
    position: absolute;
    top: 0;
    bottom: 0;
    cursor: pointer;
    border-radius: 1px;
  }
  .band:hover { box-shadow: 0 0 0 2px #111418; z-index: 3; }
  .cursor {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 2px;
    background: #111418;
    pointer-events: none;
    z-index: 2;
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    font: 0.72rem/1 ui-monospace, monospace;
    color: var(--ink-soft);
    margin: 0.3rem 0 0 10.5rem;
  }

  /* --- B's layout --------------------------------------------------------- */
  .layout {
    display: grid;
    grid-template-columns: minmax(19rem, 24rem) 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (max-width: 62rem) { .layout { grid-template-columns: 1fr; } }

  aside { position: sticky; top: 1rem; }
  aside h1 { font-size: 1.2rem; margin: 0.9rem 0 0.3rem; }
  .meta { color: var(--ink-soft); font-size: 0.85rem; margin-top: 0; }
  .review { display: flex; gap: 0.4rem; }
  aside h2 { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-soft); margin-bottom: 0.4rem; }
  .cast { list-style: none; padding: 0; margin: 0; font-size: 0.88rem; }
  .cast li { display: flex; align-items: center; gap: 0.5rem; padding: 0.18rem 0; }
  .cast em { margin-left: auto; color: var(--ink-soft); font-style: normal; font-size: 0.78rem; }
  .chip { width: 10px; height: 10px; border-radius: 2px; flex: none; }
  .legal { font-size: 0.76rem; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 0.7rem; margin-top: 1rem; }

  .toolbar {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.5rem 0.8rem;
    position: sticky;
    top: 1rem;
    z-index: 5;
    margin-bottom: 1.2rem;
  }

  /* --- A's turns ---------------------------------------------------------- */
  .turn {
    padding: 0.5rem 0.9rem 0.6rem;
    border-left: 3px solid transparent;
    border-radius: 4px;
    margin-bottom: 1.1rem;
    scroll-margin-top: 4.5rem;
  }
  .turn.playing { background: #eff6ff; border-left-color: var(--accent); }
  .turn:target { background: #fffbe6; border-left-color: var(--draft); }
  .turn.hidden { display: none; }
  .who { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.45rem; margin: 0 0 0.25rem; font-size: 0.86rem; }
  .who b { font-size: 1rem; }
  .role { color: var(--ink-soft); font-size: 0.78rem; }
  .over { font-size: 0.72rem; color: #8250df; background: #f5f0ff; padding: 0.2rem 0.4rem; border-radius: 3px; }
  .t {
    all: unset;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    color: var(--accent);
  }
  .anchor { margin-left: auto; color: var(--ink-soft); text-decoration: none; font-size: 0.75rem; opacity: 0; }
  .turn:hover .anchor { opacity: 1; }
  .said {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.72;
    font-family: Georgia, "Iowan Old Style", serif;
  }
  .said.is-draft { color: #2c3238; }
  .seg { cursor: pointer; border-radius: 2px; }
  .seg:hover { background: #eef4ff; }
  .seg.playing { background: #dbeafe; }
  .fix { font-size: 0.75rem; opacity: 0; }
  .turn:hover .fix { opacity: 1; }
</style>

<script>
  const lanes = document.querySelector(".lanes");
  const duration = Number(lanes.dataset.duration);
  const cursor = lanes.querySelector(".cursor");
  const readout = document.getElementById("readout");
  const laneEls = [...lanes.querySelectorAll(".lane")];
  const track = lanes.querySelector(".lane-track");
  const turns = [...document.querySelectorAll(".turn")];
  const follow = document.getElementById("follow");

  document.querySelectorAll("[data-t]").forEach((el) =>
    el.addEventListener("click", () => window.fcpSeek?.(Number(el.dataset.t))),
  );

  const say = (name, t) => {
    readout.textContent = name ? `${name} — ${fmt(t)}` : "";
  };
  const fmt = (t) => {
    const s = Math.floor(t);
    return `${Math.floor(s / 3600)}:${String(Math.floor((s % 3600) / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
  };

  // Hovering a band names its Speaker in the readout above and lights that lane.
  lanes.addEventListener("mousemove", (e) => {
    const band = e.target.closest(".band");
    laneEls.forEach((l) => l.classList.remove("on"));
    if (!band) return;
    band.closest(".lane").classList.add("on");
    say(band.dataset.name, Number(band.dataset.t));
  });
  lanes.addEventListener("mouseleave", () => {
    laneEls.forEach((l) => l.classList.remove("on"));
    say(null);
  });

  let current = null;
  document.addEventListener("fcp:time", (e) => {
    const t = e.detail;
    cursor.hidden = false;
    // The cursor rides the track, which starts after the name gutter.
    const box = lanes.getBoundingClientRect();
    const tb = track.getBoundingClientRect();
    cursor.style.left = `${tb.left - box.left + (t / duration) * tb.width}px`;
    let hit = null;
    for (const el of turns) {
      if (Number(el.dataset.t) <= t) hit = el;
      else break;
    }
    if (hit === current) return;
    current?.classList.remove("playing");
    hit?.classList.add("playing");
    current = hit;
    if (hit) {
      const name = hit.querySelector(".who b").textContent;
      say(name, Number(hit.dataset.t));
      laneEls.forEach((l) => l.classList.toggle("on", l.dataset.speaker === hit.dataset.speaker));
    }
    if (hit && follow.checked) hit.scrollIntoView({ block: "center", behavior: "smooth" });
  });

  document.getElementById("only-draft").addEventListener("change", (e) => {
    turns.forEach((t) => t.classList.toggle("hidden", e.target.checked && t.dataset.draft !== "true"));
  });
</script>
